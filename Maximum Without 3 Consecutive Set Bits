class Solution {
    public int maxValue(int n) {
        for (int i = 30; i >= 0; i--) {
            if (((n >> i) & 1) == 1 &&
                ((n >> (i - 1)) & 1) == 1 &&
                ((n >> (i - 2)) & 1) == 1) {
                n &= ~(1 << (i - 2));
                i = Math.min(i + 2, 31);
            }
        }
        return n;
    }
}
