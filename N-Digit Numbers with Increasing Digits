class Solution {
public:
    vector<int> increasingNumbers(int n) {
        vector<int> ans;

        if (n == 1) {
            for (int i = 0; i <= 9; i++)
                ans.push_back(i);
            return ans;
        }

        if (n > 9) return ans;

        function<void(int, int, int)> dfs = [&](int len, int start, int num) {
            if (len == n) {
                ans.push_back(num);
                return;
            }

            for (int d = start; d <= 9; d++) {
                dfs(len + 1, d + 1, num * 10 + d);
            }
        };

        dfs(0, 1, 0);

        return ans;
    }
};
