#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    int minimumEdgeReversal(vector<vector<int>>& edges, int n, int src, int dst) {

        vector<vector<pair<int, int>>> graph(n + 1);

        // Build graph
        for (auto &edge : edges) {
            int u = edge[0];
            int v = edge[1];

            // Original edge: no reversal needed
            graph[u].push_back({v, 0});

            // Reverse edge: costs 1 reversal
            graph[v].push_back({u, 1});
        }

        const int INF = 1e9;

        vector<int> dist(n + 1, INF);

        deque<int> dq;

        dist[src] = 0;
        dq.push_front(src);

        // 0-1 BFS
        while (!dq.empty()) {

            int u = dq.front();
            dq.pop_front();

            for (auto [v, cost] : graph[u]) {

                if (dist[u] + cost < dist[v]) {

                    dist[v] = dist[u] + cost;

                    if (cost == 0) {
                        dq.push_front(v);
                    } 
                    else {
                        dq.push_back(v);
                    }
                }
            }
        }

        // If destination cannot be reached
        if (dist[dst] == INF) {
            return -1;
        }

        return dist[dst];
    }
};
