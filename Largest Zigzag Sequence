class Solution {
    public int zigzagSequence(int[][] mat) {
        int n = mat.length;

        int[] dp = new int[n];

        // First row
        for (int j = 0; j < n; j++) {
            dp[j] = mat[0][j];
        }

        // Process remaining rows
        for (int i = 1; i < n; i++) {

            int max1 = -1;
            int max2 = -1;
            int maxIndex = -1;

            // Find largest and second largest
            // value from previous row
            for (int j = 0; j < n; j++) {
                if (dp[j] > max1) {
                    max2 = max1;
                    max1 = dp[j];
                    maxIndex = j;
                } else if (dp[j] > max2) {
                    max2 = dp[j];
                }
            }

            int[] newDp = new int[n];

            for (int j = 0; j < n; j++) {
                if (j == maxIndex) {
                    // Cannot use the same column
                    newDp[j] = mat[i][j] + max2;
                } else {
                    newDp[j] = mat[i][j] + max1;
                }
            }

            dp = newDp;
        }

        int answer = 0;

        for (int value : dp) {
            answer = Math.max(answer, value);
        }

        return answer;
    }
}
