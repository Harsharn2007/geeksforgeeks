class Solution {
    public int findPosition(int n) {
        // Check if n has only one set bit
        if (n == 0 || (n & (n - 1)) != 0) {
            return -1;
        }

        int position = 1;
        while ((n & 1) == 0) {
            n = n >> 1;
            position++;
        }

        return position;
    }
}
