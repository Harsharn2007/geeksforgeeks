class Solution {
    List<Integer> makeBeautiful(int[] arr) {
        // code here
        
        List<Integer> ans = new ArrayList<>();
        
        for (int num : arr) {
            
            // If last element and current element have opposite signs
            if (!ans.isEmpty() && 
               ((ans.get(ans.size() - 1) >= 0 && num < 0) ||
                (ans.get(ans.size() - 1) < 0 && num >= 0))) {
                
                ans.remove(ans.size() - 1);
            } 
            else {
                ans.add(num);
            }
        }
        
        return ans;
    }
}
