#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    string compress(string s) {
        int n = s.length();

        // LPS array
        vector<int> lps(n, 0);

        int j = 0;

        for (int i = 1; i < n; i++) {
            while (j > 0 && s[i] != s[j]) {
                j = lps[j - 1];
            }

            if (s[i] == s[j]) {
                j++;
            }

            lps[i] = j;
        }

        string ans = "";

        int i = n - 1;

        while (i >= 0) {

            // Only even length prefixes can be compressed
            if (i % 2 == 1) {

                int len = i + 1;
                int half = len / 2;

                /*
                 * Check whether:
                 *
                 * s[0 ... half-1]
                 * =
                 * s[half ... len-1]
                 *
                 * using LPS.
                 */
                if (lps[i] >= half &&
                    len % (2 * (len - lps[i])) == 0) {

                    ans += '*';

                    // Move to the first half
                    i = half - 1;

                    continue;
                }
            }

            // Cannot compress
            ans += s[i];
            i--;
        }

        reverse(ans.begin(), ans.end());

        return ans;
    }
};
