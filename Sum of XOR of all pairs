class Solution {
    static long sumXOR(int arr[]) {
        int n = arr.length;
        long total = 0;
        for (int bit = 0; bit < 32; bit++) {
            long ones = 0;
            for (int x : arr) ones += (x >> bit) & 1;
            total += ones * (n - ones) * (1L << bit);
        }
        return total;
    }
}
