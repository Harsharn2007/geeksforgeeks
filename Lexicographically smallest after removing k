class Solution:
    def lexicographicallySmallest(self, s, k):
        n = len(s)

        # Correct k
        if n & (n - 1) == 0:  # power of 2
            k //= 2
        else:
            k *= 2

        if k >= n:
            return "-1"

        stack = []

        for ch in s:
            while k > 0 and stack and stack[-1] > ch:
                stack.pop()
                k -= 1
            stack.append(ch)

        while k > 0:
            stack.pop()
            k -= 1

        ans = "".join(stack)

        return ans if ans else "-1"
