class Solution {
    public boolean wifiRange(String s, int x) {
        int n = s.length();
        boolean[] cover = new boolean[n];

        // Mark all rooms covered by wifi
        for (int i = 0; i < n; i++) {
            if (s.charAt(i) == '1') {
                int left = Math.max(0, i - x);
                int right = Math.min(n - 1, i + x);

                for (int j = left; j <= right; j++) {
                    cover[j] = true;
                }
            }
        }

        // Check if every room is covered
        for (boolean c : cover) {
            if (!c) return false;
        }

        return true;
    }
}
