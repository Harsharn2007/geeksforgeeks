class Solution {
    
    int[][] dp;
    
    int solve(String s, int index, int prevSum) {
        // If entire string is processed
        if (index == s.length()) {
            return 1;
        }

        // Memoization
        if (dp[index][prevSum] != -1) {
            return dp[index][prevSum];
        }

        int count = 0;
        int currSum = 0;

        // Try all possible substrings starting from index
        for (int i = index; i < s.length(); i++) {
            currSum += s.charAt(i) - '0';

            // Valid if current sum >= previous sum
            if (currSum >= prevSum) {
                count += solve(s, i + 1, currSum);
            }
        }

        return dp[index][prevSum] = count;
    }

    public int validGroups(String s) {
        // Maximum possible digit sum = 9 * 100 = 900
        dp = new int[101][901];

        for (int i = 0; i < 101; i++) {
            for (int j = 0; j < 901; j++) {
                dp[i][j] = -1;
            }
        }

        return solve(s, 0, 0);
    }
}
