class Solution {
    int countStrings(int n) {
        long zero = 1;
        long one = 1;
        
        for (int i = 2; i <= n; i++) {
            long newZero = zero + one;
            long newOne = zero;
            
            zero = newZero;
            one = newOne;
        }
        
        return (int)(zero + one);
    }
}
