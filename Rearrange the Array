class Solution {
public:
    static const int MOD = 1000000007;

    long long power(long long a, long long b) {
        long long res = 1;
        while (b) {
            if (b & 1)
                res = (res * a) % MOD;
            a = (a * a) % MOD;
            b >>= 1;
        }
        return res;
    }

    int minOperations(vector<int>& b) {
        int n = b.size();
        vector<int> vis(n, 0);
        map<int, int> primeExp;

        for (int i = 0; i < n; i++) {
            if (!vis[i]) {
                int cnt = 0;
                int cur = i;

                while (!vis[cur]) {
                    vis[cur] = 1;
                    cur = b[cur] - 1;
                    cnt++;
                }

                int x = cnt;
                for (int p = 2; p * p <= x; p++) {
                    if (x % p == 0) {
                        int e = 0;
                        while (x % p == 0) {
                            x /= p;
                            e++;
                        }
                        primeExp[p] = max(primeExp[p], e);
                    }
                }
                if (x > 1)
                    primeExp[x] = max(primeExp[x], 1);
            }
        }

        long long ans = 1;
        for (auto &it : primeExp)
            ans = (ans * power(it.first, it.second)) % MOD;

        return ans;
    }
};
