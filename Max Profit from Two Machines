import java.util.*;

class Solution {
    
    static class Pair {
        int a, b, diff;
        
        Pair(int a, int b) {
            this.a = a;
            this.b = b;
            this.diff = Math.abs(a - b);
        }
    }

    public int maxProfit(int x, int y, int[] a, int[] b) {
        
        int n = a.length;
        Pair[] arr = new Pair[n];
        
        for (int i = 0; i < n; i++) {
            arr[i] = new Pair(a[i], b[i]);
        }
        
        Arrays.sort(arr, (p1, p2) -> p2.diff - p1.diff);
        
        int profit = 0;
        
        for (Pair p : arr) {
            
            if ((p.a >= p.b && x > 0) || y == 0) {
                profit += p.a;
                x--;
            } else {
                profit += p.b;
                y--;
            }
        }
        
        return profit;
    }
}
