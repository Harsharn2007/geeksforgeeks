class Solution {
    public ArrayList<String> graycode(int n) {
        ArrayList<String> res = new ArrayList<>();
        int size = 1 << n;  // 2^n
        
        for (int i = 0; i < size; i++) {
            int gray = i ^ (i >> 1);
            String binary = Integer.toBinaryString(gray);
            
            // pad with leading zeros
            while (binary.length() < n) {
                binary = "0" + binary;
            }
            
            res.add(binary);
        }
        
        return res;
    }
}
