import java.util.*;

class Solution {
    public ArrayList<ArrayList<Integer>> socialNetwork(int[] arr) {

        int n = arr.length + 1;

        // parent[i] = friend of user i
        int[] parent = new int[n + 1];

        for (int i = 2; i <= n; i++) {
            parent[i] = arr[i - 2];
        }

        ArrayList<ArrayList<Integer>> ans = new ArrayList<>();

        // Process users from 2 to n
        for (int i = 2; i <= n; i++) {

            ArrayList<int[]> temp = new ArrayList<>();

            int current = i;
            int distance = 0;

            // Follow the friend chain
            while (current != 1) {
                current = parent[current];
                distance++;

                temp.add(new int[]{current, distance});
            }

            // j must be in increasing order
            for (int k = temp.size() - 1; k >= 0; k--) {

                ArrayList<Integer> list = new ArrayList<>();

                list.add(i);                 // starting user
                list.add(temp.get(k)[0]);    // reachable user
                list.add(temp.get(k)[1]);    // distance

                ans.add(list);
            }
        }

        return ans;
    }
}
