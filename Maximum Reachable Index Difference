class Solution {
public:
    int maxIndexDifference(string &s) {
        int n = s.size();

        vector<int> dp(n);
        vector<int> last(26, -1);
        vector<int> best(26, -1);

        int ans = -1;

        for (int i = n - 1; i >= 0; i--) {
            int c = s[i] - 'a';

            dp[i] = i;

            if (c < 25 && last[c + 1] != -1)
                dp[i] = best[c + 1];

            last[c] = i;
            best[c] = max(best[c], dp[i]);

            if (c == 0)
                ans = max(ans, dp[i] - i);
        }

        return ans;
    }
};
