import java.util.Arrays;

class Solution {
    public int findSmallest(int[] arr) {
        
        Arrays.sort(arr);

        long res = 1;

        for (int i = 0; i < arr.length; i++) {
            
            if (arr[i] > res) {
                return (int) res;
            }

            res += arr[i];
        }

        return (int) res;
    }
}
