
import java.util.*;

class Solution {

    static class DSU {
        int[] parent;
        long[] size;

        DSU(int n) {
            parent = new int[n + 1];
            size = new long[n + 1];

            for (int i = 1; i <= n; i++) {
                parent[i] = i;
                size[i] = 1;
            }
        }

        int find(int x) {
            if (parent[x] != x) {
                parent[x] = find(parent[x]);
            }
            return parent[x];
        }

        long union(int u, int v) {
            int a = find(u);
            int b = find(v);

            if (a == b) return 0;

            long paths = size[a] * size[b];

            if (size[a] < size[b]) {
                int temp = a;
                a = b;
                b = temp;
            }

            parent[b] = a;
            size[a] += size[b];

            return paths;
        }
    }

    public ArrayList<Integer> maximumWeight(
        int n, int[][] edges, int[] queries) {

        Arrays.sort(edges, (a, b) ->
            Integer.compare(a[2], b[2]));

        int q = queries.length;

        int[][] sortedQueries = new int[q][2];

        for (int i = 0; i < q; i++) {
            sortedQueries[i][0] = queries[i];
            sortedQueries[i][1] = i;
        }

        Arrays.sort(sortedQueries, (a, b) ->
            Integer.compare(a[0], b[0]));

        ArrayList<Integer> ans = new ArrayList<>(
            Collections.nCopies(q, 0));

        DSU dsu = new DSU(n);

        int j = 0;
        long totalPaths = 0;

        for (int i = 0; i < q; i++) {

            int limit = sortedQueries[i][0];
            int index = sortedQueries[i][1];

            while (j < edges.length &&
                   edges[j][2] <= limit) {

                totalPaths += dsu.union(
                    edges[j][0], edges[j][1]);

                j++;
            }

            ans.set(index, (int) totalPaths);
        }

        return ans;
    }
}
