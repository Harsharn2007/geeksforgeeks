class Solution {
    public int maxTask(int[] h, int[] l) {

        int n = h.length;

        if (n == 1) {
            return Math.max(h[0], l[0]);
        }

        int prev2 = Math.max(h[0], l[0]);

        int prev1 = Math.max(
            prev2 + l[1],
            h[1]
        );

        for (int i = 2; i < n; i++) {

            int low = prev1 + l[i];

            int high = prev2 + h[i];

            int current = Math.max(low, high);

            prev2 = prev1;
            prev1 = current;
        }

        return prev1;
    }
}
