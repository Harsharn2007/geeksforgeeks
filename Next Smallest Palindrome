class Solution {
    static int[] nextPalindrome(int[] num) {
        int n = num.length;

        // Check if all 9's
        boolean all9 = true;
        for (int i = 0; i < n; i++) {
            if (num[i] != 9) {
                all9 = false;
                break;
            }
        }

        if (all9) {
            int[] res = new int[n + 1];
            res[0] = 1;
            res[n] = 1;
            return res;
        }

        int[] res = num.clone();

        int mid = n / 2;
        int i = mid - 1;
        int j = (n % 2 == 0) ? mid : mid + 1;

        // Find first mismatch
        while (i >= 0 && res[i] == res[j]) {
            i--;
            j++;
        }

        boolean leftSmaller = false;
        if (i < 0 || res[i] < res[j]) {
            leftSmaller = true;
        }

        // Mirror left to right
        while (i >= 0) {
            res[j] = res[i];
            i--;
            j++;
        }

        // Handle carry if needed
        if (leftSmaller) {
            int carry = 1;
            i = mid - 1;

            if (n % 2 == 1) {
                res[mid] += carry;
                carry = res[mid] / 10;
                res[mid] %= 10;
                j = mid + 1;
            } else {
                j = mid;
            }

            while (i >= 0) {
                res[i] += carry;
                carry = res[i] / 10;
                res[i] %= 10;
                res[j] = res[i];
                i--;
                j++;
            }
        }

        return res;
    }
}
