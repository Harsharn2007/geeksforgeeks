
class Solution {
    public boolean balancePan(int a, int b) {
        long num = b;

        while (num > 0) {
            long rem = num % a;

            if (rem == 0 || rem == 1) {
                num /= a;
            } else if (rem == a - 1) {
                num = num / a + 1;
            } else {
                return false;
            }
        }

        return true;
    }
}
