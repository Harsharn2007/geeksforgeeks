class Solution {
    public int minCost(int n, int i, int d, int c) {

        long[] dp = new long[n + 1];

        dp[0] = 0;

        for (int x = 1; x <= n; x++) {

            // Option 1: Insert one character
            dp[x] = dp[x - 1] + i;

            if (x == 1) {
                continue;
            }

            if (x % 2 == 0) {
                // Option 2: Create half, then copy-paste
                dp[x] = Math.min(
                    dp[x],
                    dp[x / 2] + c
                );

            } else {
                // Option 2: Copy from floor(x/2), then insert
                dp[x] = Math.min(
                    dp[x],
                    dp[x / 2] + c + i
                );

                // Option 3: Create ceil(x/2), copy, then delete
                dp[x] = Math.min(
                    dp[x],
                    dp[x / 2 + 1] + c + d
                );
            }
        }

        return (int) dp[n];
    }
}
