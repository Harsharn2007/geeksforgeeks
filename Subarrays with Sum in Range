class Solution {

    static long countAtMost(int[] arr, long limit) {
        if (limit < 0) return 0;

        long count = 0;
        long sum = 0;
        int left = 0;

        for (int right = 0; right < arr.length; right++) {
            sum += arr[right];

            while (sum > limit) {
                sum -= arr[left++];
            }

            count += (right - left + 1);
        }

        return count;
    }

    public int countSubarray(int[] arr, int l, int r) {
        return (int)(countAtMost(arr, r) - countAtMost(arr, (long)l - 1));
    }
}
