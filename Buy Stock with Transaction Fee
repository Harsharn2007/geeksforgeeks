class Solution {
    public int maxProfit(int[] arr, int k) {
        int n = arr.length;
        
        int hold = -arr[0]; // buying first stock
        int cash = 0;       // no stock, no profit
        
        for (int i = 1; i < n; i++) {
            int prevCash = cash;
            
            // sell stock today
            cash = Math.max(cash, hold + arr[i] - k);
            
            // buy stock today
            hold = Math.max(hold, prevCash - arr[i]);
        }
        
        return cash;
    }
}
