
import java.util.*;

class Solution {
    public ArrayList<Integer> lexicographicallyLargest(int[] arr) {
        int n = arr.length;
        ArrayList<Integer> result = new ArrayList<>();

        for (int x : arr) {
            result.add(x);
        }

        int i = 0;

        while (i < n) {
            int j = i + 1;

            // Find a consecutive group with the same parity
            while (j < n &&
                   result.get(j) % 2 == result.get(i) % 2) {
                j++;
            }

            // Sort the group in descending order
            result.subList(i, j).sort(Collections.reverseOrder());

            i = j;
        }

        return result;
    }
}
