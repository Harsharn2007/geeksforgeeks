class Solution {
    public int derangeCount(int n) {
        int mod = 1000000007;

        if (n == 1) return 0;
        if (n == 2) return 1;

        long prev2 = 0; // D(1)
        long prev1 = 1; // D(2)
        long curr = 0;

        for (int i = 3; i <= n; i++) {
            curr = ((i - 1) * (prev1 + prev2)) % mod;
            prev2 = prev1;
            prev1 = curr;
        }

        return (int) prev1;
    }
}
