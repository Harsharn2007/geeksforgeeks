class Solution {

    public int minCount(int[] arr) {
        int n = arr.length;

        int[][][] dp = new int[n + 1][n + 1][n + 1];

        for (int i = 0; i <= n; i++) {
            for (int j = 0; j <= n; j++) {
                for (int k = 0; k <= n; k++) {
                    dp[i][j][k] = -1;
                }
            }
        }

        return solve(0, -1, -1, arr, dp);
    }

    private int solve(int pos, int incLast, int decLast,
                      int[] arr, int[][][] dp) {

        if (pos == arr.length) {
            return 0;
        }

        int i = incLast + 1;
        int j = decLast + 1;

        if (dp[pos][i][j] != -1) {
            return dp[pos][i][j];
        }

        // Don't use current element
        int best = 1 + solve(pos + 1, incLast, decLast, arr, dp);

        // Put current element in increasing subsequence
        if (incLast == -1 || arr[pos] > arr[incLast]) {
            best = Math.min(
                best,
                solve(pos + 1, pos, decLast, arr, dp)
            );
        }

        // Put current element in decreasing subsequence
        if (decLast == -1 || arr[pos] < arr[decLast]) {
            best = Math.min(
                best,
                solve(pos + 1, incLast, pos, arr, dp)
            );
        }

        return dp[pos][i][j] = best;
    }
}
