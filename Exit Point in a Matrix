import java.util.*;

class Solution {
    public List<Integer> exitPoint(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;

        int i = 0, j = 0;
        int dir = 0; // 0=right, 1=down, 2=left, 3=up

        while (true) {

            if (mat[i][j] == 1) {
                dir = (dir + 1) % 4;
                mat[i][j] = 0;
            }

            int ni = i, nj = j;

            if (dir == 0) {
                nj++;
            } else if (dir == 1) {
                ni++;
            } else if (dir == 2) {
                nj--;
            } else {
                ni--;
            }

            if (ni < 0 || ni >= n || nj < 0 || nj >= m) {
                List<Integer> ans = new ArrayList<>();
                ans.add(i);
                ans.add(j);
                return ans;
            }

            i = ni;
            j = nj;
        }
    }
}
